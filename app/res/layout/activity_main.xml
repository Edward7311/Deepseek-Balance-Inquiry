<?xml version="1.0" encoding="utf-8"?>
<!--
  根布局是 FrameLayout，因为它要叠两层：
    ① 正常内容（标题 + 可滚动的主体）
    ② 登录用的 WebView 覆盖层 —— 未登录时铺满，登录后缩成 1dp 留在后台

  放在覆盖层而不是滚动区里，是为了避开 WebView 和 ScrollView 抢触摸事件的问题。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 标题栏（固定在顶部，不跟着滚） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="8dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/browser_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/browser_toggle"
                android:scaleType="centerInside"
                android:src="@drawable/ic_globe" />

            <ImageButton
                android:id="@+id/theme_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/theme_title"
                android:scaleType="centerInside"
                android:src="@drawable/ic_theme" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 主体：单页滚动 -->
        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbarStyle="outsideOverlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <include layout="@layout/page_balance" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/bg_page_alt" />

                <include layout="@layout/page_usage" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!--
      WebView 覆盖层：登录时铺满，登录后缩成 1dp。
      「完成」是逃生出口 —— 万一自动检测登录没生效，用户还能手动收起来，
      不至于被登录页盖住、连按钮都点不到。
    -->
    <FrameLayout
        android:id="@+id/webview_holder"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:background="@color/bg_page">

        <TextView
            android:id="@+id/usage_login_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:background="@drawable/btn_primary"
            android:paddingStart="24dp"
            android:paddingTop="13dp"
            android:paddingEnd="24dp"
            android:paddingBottom="13dp"
            android:text="@string/usage_login_done"
            android:textColor="@color/accent_text"
            android:textSize="15sp" />
    </FrameLayout>
</FrameLayout>
